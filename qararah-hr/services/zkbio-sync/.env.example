# Copy to .env on the central Windows server. Keep secrets out of Git/chat.
# Safe by default: dry-run reads ZKBio but never sends attendance to Supabase.
SYNC_MODE=dry-run
SYNC_INTERVAL_MINUTES=15
SYNC_OVERLAP_MINUTES=30
SYNC_INITIAL_FROM=
STATE_FILE=./state/live-state.json
HTTP_TIMEOUT_SECONDS=45
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=3

ZKBIO_BASE_URL=http://127.0.0.1:8089
ZKBIO_USERNAME=
ZKBIO_PASSWORD=
ZKBIO_AUTH_PATH=/api-token-auth/
ZKBIO_TOKEN_FIELD=token
ZKBIO_TRANSACTIONS_PATH=/iclock/api/transactions/
ZKBIO_TERMINALS_PATH=/iclock/api/terminals/
ZKBIO_PAGE_SIZE=500
ZKBIO_TIME_ZONE=Africa/Tripoli
ZKBIO_TRANSACTIONS_RESULTS_FIELD=results
ZKBIO_DEVICES_RESULTS_FIELD=results
ZKBIO_RECORD_ID_FIELD=id
ZKBIO_EMPLOYEE_CODE_FIELD=emp_code
ZKBIO_PUNCH_DEVICE_FIELD=terminal_sn
ZKBIO_PUNCH_TIME_FIELD=punch_time
ZKBIO_PUNCH_TYPE_FIELD=punch_state
ZKBIO_DEVICE_SERIAL_FIELD=terminal_sn
ZKBIO_DEVICE_NAME_FIELD=terminal_alias
ZKBIO_DEVICE_STATUS_FIELD=state
ZKBIO_DEVICE_LAST_ACTIVITY_FIELD=last_activity

# Required only after a separate Supabase staging project and Edge Function are ready.
# Use the function URL, e.g. https://PROJECT.supabase.co/functions/v1/zkbio-attendance-ingest
SUPABASE_INGEST_URL=
SUPABASE_SYNC_TOKEN=
